    {
      "@id": "urn:uuid:20000000-0000-4000-8000-000000000010",
      "@type": [
        "CreativeWork",
        "marin:NoteSection"
      ],
      "identifier": "sample-overview",
      "name": "Overview",
      "marin:sectionType": "overview",
      "marin:text": "Plain language helps people find what they need and act on it. This sample note shows the Note format. Write short sentences. Use common words. Say what you want the reader to do."
    },
    {
      "@id": "urn:uuid:20000000-0000-4000-8000-000000000011",
      "@type": [
        "CreativeWork",
        "marin:NoteSection"
      ],
      "identifier": "sample-why-it-matters",
      "name": "Why it matters",
      "marin:sectionType": "whyItMatters",
      "marin:items": [
        "People can use a service only if they understand it.",
        "Clear writing saves staff time on follow-up calls.",
        "Plain words make public information fair for everyone."
      ]
    },
    {
      "@id": "urn:uuid:20000000-0000-4000-8000-000000000020",
      "@type": [
        "CreativeWork",
        "marin:NoteSection"
      ],
      "identifier": "sample-problem",
      "name": "Problem",
      "marin:sectionType": "problem",
      "marin:text": "Many notices and forms are hard to read. People miss what they need to do, and staff spend time answering the same questions."
    },
    {
      "@id": "urn:uuid:20000000-0000-4000-8000-000000000021",
      "@type": [
        "CreativeWork",
        "marin:NoteSection"
      ],
      "identifier": "sample-solution",
      "name": "Solution",
      "marin:sectionType": "solution",
      "marin:text": "Write in plain language. Lead with the action, use short sentences and common words, and test the text with a real reader."
    },
    {
      "@id": "urn:uuid:20000000-0000-4000-8000-000000000012",
      "@type": [
        "CreativeWork",
        "marin:NoteSection"
      ],
      "identifier": "sample-user-stories",
      "name": "User stories",
      "marin:sectionType": "userStories",
      "marin:items": [
        "As a resident, I want a short form so I can finish it on my phone.",
        "As a manager, I want clear emails so my team knows the next step.",
        "As a clerk, I want simple notices so fewer people call with questions."
      ]
    },
    {
      "@id": "urn:uuid:20000000-0000-4000-8000-000000000013",
      "@type": [
        "CreativeWork",
        "marin:NoteSection"
      ],
      "identifier": "sample-key-terms",
      "name": "Key terms",
      "marin:sectionType": "keyTerms",
      "marin:items": [
        {
          "term": "Plain language",
          "definition": "Writing your reader can understand the first time they read it."
        },
        {
          "term": "Active voice",
          "definition": "A sentence where the doer comes first: \"The clerk reviews the form.\""
        },
        {
          "term": "Reading level",
          "definition": "The school grade a person needs to read a text with ease."
        },
        {
          "term": "Jargon",
          "definition": "Words only insiders know."
        },
        {
          "term": "Call to action",
          "definition": "The one thing you want the reader to do next."
        },
        {
          "term": "Sentence case",
          "definition": "Capitalize the first word and proper names only."
        }
      ]
    },
    {
      "@id": "urn:uuid:20000000-0000-4000-8000-000000000014",
      "@type": [
        "CreativeWork",
        "marin:NoteSection"
      ],
      "identifier": "sample-dos-and-donts",
      "name": "Do’s and don’ts",
      "marin:sectionType": "dosAndDonts",
      "marin:items": [
        {
          "do": "Lead with what the reader needs.",
          "dont": "Bury the main point in the last paragraph."
        },
        {
          "do": "Use short sentences.",
          "dont": "Pack three ideas into one sentence."
        },
        {
          "do": "Explain any term you must use.",
          "dont": "Assume everyone knows your acronyms."
        },
        {
          "do": "Test with a real reader.",
          "dont": "Guess what will make sense."
        }
      ]
    },
    {
      "@id": "urn:uuid:20000000-0000-4000-8000-000000000015",
      "@type": [
        "CreativeWork",
        "marin:NoteSection"
      ],
      "identifier": "sample-questions",
      "name": "Questions to ask",
      "marin:sectionType": "questions",
      "marin:items": [
        "Who is the reader?",
        "What do they need to do?",
        "Which words might they not know?",
        "What is the one main point?",
        "How will we know it worked?"
      ]
    },
    {
      "@id": "urn:uuid:20000000-0000-4000-8000-000000000016",
      "@type": [
        "CreativeWork",
        "marin:NoteSection"
      ],
