      ]
    },
    {
      "@id": "urn:uuid:20000000-0000-4000-8000-000000000017",
      "@type": [
        "CreativeWork",
        "marin:NoteSection"
      ],
      "identifier": "sample-checklist",
      "name": "Checklist",
      "marin:sectionType": "checklist",
      "marin:items": [
        "The first sentence says what the reader should do.",
        "Sentences are short.",
        "Every unusual term is explained.",
        "Headings use sentence case.",
        "A person outside the team has read it."
      ]
    },
    {
      "@id": "urn:uuid:20000000-0000-4000-8000-000000000018",
      "@type": [
        "CreativeWork",
        "marin:NoteSection"
      ],
      "identifier": "sample-mantras",
      "name": "Mantras",
      "marin:sectionType": "mantras",
      "marin:items": [
        "Say it simply.",
        "Lead with the action.",
        "Write for the reader."
      ]
    },
